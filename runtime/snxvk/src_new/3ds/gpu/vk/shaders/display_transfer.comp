// A display transfer (GX command 3), one invocation per output pixel: sw_blitter.cpp's loop as transfer.c ports it,
// its 2x and 4x box filters' integer truncation kept. The caller checked both spans lie in their buffers.
#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, set = 0, binding = 0) readonly buffer In { uint8_t SRC[]; };
layout(std430, set = 0, binding = 1) buffer Out { uint8_t DST[]; };
layout(push_constant) uniform Transfer {
    uint in_offset, out_offset, in_w, out_w, out_h; // out_* after scaling
    uint in_fmt, out_fmt, scaling, flags;           // flags: 1 flip, 2 linear, 4 no swizzle
    uint skew;
};
#include "pixel.glsl"
void main() {
    uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y;
    if (x >= out_w || y >= out_h) return;
    uint hs = scaling != 0u ? 1u : 0u, vs = scaling == 2u ? 1u : 0u;
    uint in_bpp = pixel_bytes(in_fmt), out_bpp = pixel_bytes(out_fmt);
    uint input_x = x << hs, input_y = y << vs, output_y = (flags & 1u) != 0u ? out_h - y - 1u : y;
    uint src, dst;
    uint tiled_dst = morton(x, output_y, out_bpp) + (output_y & ~7u) * out_w * out_bpp;
    uint linear_dst = (x + output_y * out_w) * out_bpp;
    if ((flags & 2u) != 0u) {
        src = (input_x + input_y * in_w) * in_bpp;
        dst = (flags & 4u) == 0u ? tiled_dst : linear_dst;
    } else {
        src = morton(input_x, input_y, in_bpp) + (input_y & ~7u) * in_w * in_bpp;
        dst = (flags & 4u) == 0u ? linear_dst : tiled_dst;
    }
    src += in_offset;
    dst += out_offset + skew;
    uvec4 c = decode(in_fmt, src);
    if (scaling == 1u)
        c = (c + decode(in_fmt, src + in_bpp)) / 2u;
    else if (scaling == 2u)
        c = (c + decode(in_fmt, src + in_bpp) + decode(in_fmt, src + 2u * in_bpp) + decode(in_fmt, src + 3u * in_bpp)) / 4u;
    encode(out_fmt, c, dst);
}
