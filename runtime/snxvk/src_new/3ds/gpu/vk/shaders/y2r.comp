// The Y2R engine's conversion (vk/y2r.c), one invocation per output pixel in the order the engine writes them: the
// strip, tile and slot it comes from found by undoing gpu/y2r.c's layout (Azahar's hw/y2r.cpp, ported there), then
// the YUV samples it reads, converted with the same fixed point. Every stream is the guest's virtual memory: its
// bytes go through PAGES, the window offset of each 4 KiB page it spans.
#version 450
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer InY { uint8_t SY[]; };
layout(std430, set = 0, binding = 1) readonly buffer InU { uint8_t SU[]; };
layout(std430, set = 0, binding = 2) readonly buffer InV { uint8_t SV[]; };
layout(std430, set = 0, binding = 3) buffer Out { uint8_t DST[]; };
layout(std430, set = 0, binding = 4) readonly buffer Pages { uint PAGES[]; };
layout(push_constant) uniform Conversion {
    uvec4 streams[4]; // Y (or YUYV), U, V, output: first page's index in PAGES, offset in that page, unit, gap
    uint width, lines;
    uint modes; // input format, output format << 8, rotation << 16, 8x8 alignment << 24
    uint alpha;
    ivec4 k;    // the coefficients, two 16-bit ones a word, the first in the low half
};
// the stream's byte i: where its DMA puts it, through its pages
uint at(uint s, uint i) {
    uvec4 b = streams[s];
    uint offset = i / b.z * (b.z + b.w) + i % b.z + b.y;
    return PAGES[b.x + (offset >> 12)] + (offset & 4095u);
}
uint sample_y(uint i) { return uint(SY[at(0u, i)]); }
int coefficient(uint i) {
    int word = k[i >> 1];
    return (i & 1u) == 0u ? (word << 16) >> 16 : word >> 16;
}
const uint MORTON_INVERSE[64] = uint[](0u,  1u,  8u,  9u,  2u,  3u,  10u, 11u, 16u, 17u, 24u, 25u, 18u, 19u, 26u, 27u,
                                       4u,  5u,  12u, 13u, 6u,  7u,  14u, 15u, 20u, 21u, 28u, 29u, 22u, 23u, 30u, 31u,
                                       32u, 33u, 40u, 41u, 34u, 35u, 42u, 43u, 48u, 49u, 56u, 57u, 50u, 51u, 58u, 59u,
                                       36u, 37u, 44u, 45u, 38u, 39u, 46u, 47u, 52u, 53u, 60u, 61u, 54u, 55u, 62u, 63u);
void main() {
    uint q = gl_GlobalInvocationID.x;
    if (q >= width * lines) return;
    uint in_fmt = modes & 255u, out_fmt = modes >> 8 & 255u, rotation = modes >> 16 & 255u, block = modes >> 24;
    uint y0 = q / (width * 8u) * 8u, p = q - y0 * width, rows = min(lines - y0, 8u), tiles = width / 8u;
    // the strip's slot p: its tile and the rotated tile's entry k
    uint tile, slot;
    if (block != 0u) {
        tile = p / 64u;
        slot = MORTON_INVERSE[p % 64u];
    } else if ((rotation & 1u) == 0u) {
        uint row = p / width, column = p % width;
        tile = column / 8u;
        slot = row * 8u + column % 8u;
    } else {
        tile = p / (8u * rows);
        slot = p % (8u * rows);
    }
    uint from; // the entry of the source tile it was rotated from
    if (rotation == 0u)
        from = slot;
    else if (rotation == 1u)
        from = (rows - 1u - slot % rows) * 8u + slot / rows;
    else if (rotation == 2u)
        from = rows * 8u - 1u - slot;
    else
        from = slot % rows * 8u + 7u - slot / rows;
    uint source = rotation >= 2u ? tiles - 1u - tile : tile;
    uint x = source * 8u + from % 8u, y = y0 + from / 8u;
    // the samples, from each input's stream as a whole (the strips take them in order)
    int Y, U, V;
    if (in_fmt == 4u) { // YUYV
        Y = int(sample_y((y * width + x) * 2u));
        U = int(sample_y((y * width + x / 2u * 2u) * 2u + 1u));
        V = int(sample_y((y * width + x / 2u * 2u) * 2u + 3u));
    } else {
        uint n = in_fmt == 2u || in_fmt == 3u ? 2u : 1u;
        uint c = in_fmt == 1u || in_fmt == 3u ? (y / 2u * width + x) / 2u : (y * width + x) / 2u;
        Y = int(sample_y((y * width + x) * n));
        U = int(SU[at(1u, c * n)]);
        V = int(SV[at(2u, c * n)]);
    }
    int cy = coefficient(0u) * Y;
    int r = cy + coefficient(1u) * V, g = cy - coefficient(2u) * V - coefficient(3u) * U, b = cy + coefficient(4u) * U;
    r = clamp(((r >> 3) + coefficient(5u) + 24) >> 5, 0, 255);
    g = clamp(((g >> 3) + coefficient(6u) + 24) >> 5, 0, 255);
    b = clamp(((b >> 3) + coefficient(7u) + 24) >> 5, 0, 255);
    // the output pixel in its format (gpu/transfer.c's encodings: RGBA8 A, B, G, R; RGB8 B, G, R; 16-bit ones
    // little-endian), each byte where the output's DMA writes it
    uint a = alpha & 255u, bytes[4], count = 2u;
    uint v;
    if (out_fmt == 0u) {
        bytes[0] = a, bytes[1] = uint(b), bytes[2] = uint(g), bytes[3] = uint(r), count = 4u;
    } else if (out_fmt == 1u) {
        bytes[0] = uint(b), bytes[1] = uint(g), bytes[2] = uint(r), count = 3u;
    } else {
        if (out_fmt == 2u) // RGB5A1
            v = (uint(r) >> 3) << 11 | (uint(g) >> 3) << 6 | (uint(b) >> 3) << 1 | a >> 7;
        else // RGB565
            v = (uint(r) >> 3) << 11 | (uint(g) >> 2) << 5 | uint(b) >> 3;
        bytes[0] = v & 255u, bytes[1] = v >> 8;
    }
    for (uint i = 0u; i < count; ++i) DST[at(3u, q * count + i)] = uint8_t(bytes[i]);
}
