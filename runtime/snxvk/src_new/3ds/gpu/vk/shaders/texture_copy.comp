// A texture copy (GX command 4), one invocation per 16-byte chunk: the widths and gaps are whole 16-byte units, so a
// chunk is never cut by a line's end, and chunk k is at the same place of the walk transfer.c's copy_walk makes.
#version 450
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer In { uint8_t SRC[]; };
layout(std430, set = 0, binding = 1) buffer Out { uint8_t DST[]; };
layout(push_constant) uniform Copy {
    uint in_offset, out_offset, chunks, in_width, in_gap, out_width, out_gap;
};
void main() {
    uint k = gl_GlobalInvocationID.x;
    if (k >= chunks) return;
    uint at = k * 16u;
    uint src = in_offset + (at / in_width) * (in_width + in_gap) + at % in_width;
    uint dst = out_offset + (at / out_width) * (out_width + out_gap) + at % out_width;
    for (uint i = 0u; i < 16u; ++i) DST[dst + i] = SRC[src + i];
}
